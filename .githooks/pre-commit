#!/bin/sh
#
# NETS pre-commit hook.
#
#   1. Refuse data files, even force-added ones (git add -f bypasses .gitignore).
#   2. Refuse added lines that contain positions with sub-degree precision.
#   3. Stamp NETS's version and date into VERSION (and the README line), as BAIT does.
#
# Enable once per clone (from the NETS repository root):
#
#   git config core.hooksPath .githooks
#
# A file containing a line that consists only of the comment "# nets:allow-synthetic" (or
# the HTML comment form) is exempt from check 2; the test suite uses invented positions. Bypassing the hook with --no-verify should be
# a deliberate, reviewed decision.
#
set -e
LC_ALL=C
export LC_ALL

repo_root=$(git rev-parse --show-toplevel)
hook_dir=$(cd "$(dirname "$0")" && pwd)
nets_root=$(dirname "$hook_dir")
git_dir=$(git rev-parse --git-dir)

# Leave merges and rebases alone; they replay commits that were already checked.
if [ -e "$git_dir/MERGE_HEAD" ] || [ -e "$git_dir/rebase-merge" ] || [ -e "$git_dir/rebase-apply" ]; then
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# ---- 1. Data files ----------------------------------------------------------------------
data_ext='\.(pdf|csv|tsv|txt|xlsx|xls|docx|pptx|odt|ods|rds|rda|rdata|duckdb|sqlite|db|parquet|feather|xml|zip|html|htm|png|jpg|jpeg|tif|tiff)$'
bad_files=$(printf '%s\n' "$staged" | grep -Ei "$data_ext" || true)
if [ -n "$bad_files" ]; then
  echo "NETS pre-commit: refusing to commit data or output files:" >&2
  printf '%s\n' "$bad_files" | sed 's/^/  /' >&2
  echo "NETS holds instructions and code only. Survey material belongs in the workspace." >&2
  exit 1
fi

# ---- 2. Positions ---------------------------------------------------------------------
# Degree signs are matched as UTF-8 byte sequences (LC_ALL=C).
deg='(°|º|˚)'
mins="('|′|’|´)"
coord="[0-9]{1,3} ?$deg ?[0-9]{1,2}([.,][0-9]+)? ?$mins? ?[NSEWO]([^A-Za-z]|\$)"
coord="$coord|[0-9]{1,3} [0-9]{1,2}[.,][0-9]+ ?[NSEWO]([^A-Za-z]|\$)"
coord="$coord|[0-9]{1,3}[.,][0-9]{2,} ?$deg? ?[NSEWO]([^A-Za-z]|\$)"

found=""
old_ifs=$IFS
IFS='
'
for f in $staged; do
  if git show ":$f" 2>/dev/null | grep -Eq '^[[:space:]]*(#|<!--)[[:space:]]*nets:allow-synthetic[[:space:]]*(-->)?[[:space:]]*$'; then
    continue
  fi
  hits=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -v '^+++' | grep -En "$coord" || true)
  if [ -n "$hits" ]; then
    found="$found
$f:
$hits"
  fi
done
IFS=$old_ifs
if [ -n "$found" ]; then
  echo "NETS pre-commit: added lines contain what look like precise positions:" >&2
  printf '%s\n' "$found" | head -n 20 >&2
  echo "Use whole degrees or synthetic values marked 'nets:allow-synthetic'." >&2
  exit 1
fi

# ---- 3. Version stamp -----------------------------------------------------------------
version_file="$nets_root/VERSION"
readme="$nets_root/README.md"
rel_version=${version_file#"$repo_root"/}

read_version() {
  sed -n 's/^version:[[:space:]]*//p' | head -n 1
}

head_version=$(git show "HEAD:$rel_version" 2>/dev/null | read_version || true)
if [ -f "$version_file" ]; then
  file_version=$(read_version < "$version_file")
else
  file_version=""
fi

if [ -z "$file_version" ]; then
  new_version="0.1.0"
elif [ "$file_version" != "$head_version" ]; then
  new_version="$file_version"
else
  major=${file_version%%.*}
  rest=${file_version#*.}
  minor=${rest%%.*}
  patch=${rest#*.}
  case "$patch" in
    ''|*[!0-9]*) patch=0 ;;
  esac
  new_version="$major.$minor.$((patch + 1))"
fi

today=$(date +%Y-%m-%d)
printf 'version: %s\ndate: %s\n' "$new_version" "$today" > "$version_file"
git add -- "$version_file"

if [ -f "$readme" ] && git diff --quiet -- "$readme"; then
  tmp="$readme.versiontmp"
  sed "s|<!-- version -->.*<!-- /version -->|<!-- version -->**Version $new_version** ($today)<!-- /version -->|" \
    "$readme" > "$tmp"
  if cmp -s "$tmp" "$readme"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$readme"
    git add -- "$readme"
  fi
fi

exit 0
